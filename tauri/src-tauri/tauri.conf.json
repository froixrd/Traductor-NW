{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Traductor NWN",
  "version": "3.0.0",
  "identifier": "es.froixrd.traductornwn",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Traductor NWN",
        "width": 520,
        "height": 780,
        "minWidth": 400,
        "minHeight": 360,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"],
    "copyright": "© 2026 froixrd",
    "publisher": "froixrd"
  }
}
